{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subsource-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "subsource-bot",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "BOT_USERNAME": "",
    "LOG_LEVEL": "info"
  }
}
